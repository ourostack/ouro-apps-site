{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ouro-apex",
  "main": "worker.js",
  "compatibility_date": "2026-07-02",
  "routes": [
    { "pattern": "ouro.bot/*", "zone_name": "ouro.bot" },
    { "pattern": "www.ouro.bot/*", "zone_name": "ouro.bot" },
    { "pattern": "ui.ouro.bot/*", "zone_name": "ouro.bot" }
  ]
}
